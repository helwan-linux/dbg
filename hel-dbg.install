#!/bin/bash

_set_wallpaper() {
    local user="$1"
    local uid="$2"
    local bus_address="unix:path=/run/user/$uid/bus"

    if [ -S "/run/user/$uid/bus" ]; then
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="$bus_address" gsettings set org.cinnamon.desktop.background picture-uri "file:///usr/share/backgrounds/helwan-bg.png"
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="$bus_address" gsettings set org.cinnamon.desktop.background picture-uri-dark "file:///usr/share/backgrounds/helwan-bg.png"
    else
        echo "تحذير: لم يتم العثور على جلسة D-Bus نشطة للمستخدم '$user' (UID: $uid). قد تحتاج إلى تسجيل الدخول مرة أخرى لتطبيق الخلفية."
    fi
}

post_install() {
    echo "جاري تطبيق الخلفية لجميع المستخدمين..."
    IFS=$'\n'
    for line in $(getent passwd | awk -F: '$3 >= 1000 && $3 != 65534 {print $1 "|" $3}'); do
        user="${line%%|*}"
        uid="${line##*|}"
        if [ -n "$user" ]; then
            _set_wallpaper "$user" "$uid"
        fi
    done
    unset IFS
    echo "اكتملت عملية تطبيق الخلفية."
}

post_upgrade() {
    post_install
}
