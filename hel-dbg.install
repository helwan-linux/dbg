post_upgrade() {
    for uid in $(loginctl list-users --no-legend | awk '$1 >= 1000 {print $1}'); do
        bus="/run/user/$uid/bus"

        [ -S "$bus" ] || continue

        runuser -u "#$uid" -- \
            env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
            gsettings set org.cinnamon.desktop.background picture-uri \
            "file:///usr/share/backgrounds/helwan-bg.png"

        runuser -u "#$uid" -- \
            env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
            gsettings set org.cinnamon.desktop.background picture-uri-dark \
            "file:///usr/share/backgrounds/helwan-bg.png"
    done
}

post_install() {
    post_upgrade
}
